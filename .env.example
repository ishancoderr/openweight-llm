# Copy to .env and edit:  cp .env.example .env

# Shared secret the agents send in the X-API-Key header. Requests are refused while this is empty.
API_KEY=change-me

# Folder inside the container where ./models is mounted (read-only).
MODELS_DIR=/models

# Base model file in MODELS_DIR, downloaded by prepare_model.sh from Qwen/Qwen3-8B-GGUF.
BASE_GGUF=Qwen3-8B-Q4_K_M.gguf

# LoRA adapter in MODELS_DIR, converted from ./adapter by prepare_model.sh.
ADAPTER_GGUF=adapter.gguf

# Layers to put on the GPU; -1 = all of them (Qwen3-8B has 36).
GPU_LAYERS=-1

# CPU threads for llama.cpp; the g4dn.xlarge has 4 vCPUs.
THREADS=4

# Context window in tokens (prompt + answer). Lower it, e.g. to 2048, if the GPU runs out of memory.
CTX_SIZE=4096

# true: build the prompt like the training notebooks, apply_chat_template(..., enable_thinking=False),
# which pre-fills an empty <think></think> block; any <think>...</think> is also removed from the
# answer, so the agents' query parser receives clean JSON.
DISABLE_THINKING=true
